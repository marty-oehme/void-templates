# Template file for 'git-bug'
pkgname=git-bug-bin
# renovate: datasource=github-tags depName=git-bug/git-bug
version=0.12.0
revision=1
archs="x86_64"
depends="git"
short_desc="Distributed, offline-first bug tracker embedded in git, with bridges"
maintainer="Marty Oehme <contact@martyoeh.me>"
license="GPL-3.0-only"
homepage="https://github.com/git-bug/git-bug"
# Upstream's release binary is built with the webui tag, so it includes the
# embedded web interface.
distfiles="${homepage}/releases/download/v${version}/git-bug_linux_amd64.tar.gz"
checksum=7819e9a7249d44a3bdbb8c658112e748a184af2ade73de42f299219cd4189587
replaces="git-bug>=0"

do_install() {
	vbin git-bug
	vlicense LICENSE

	local m
	for m in man/*.1; do
		vman "$m"
	done

	vcompletion completion/bash/git-bug bash
	vcompletion completion/fish/git-bug fish
	vcompletion completion/zsh/git-bug zsh

	vdoc README.md
	vdoc INSTALLATION.md
}
